# Database Connection URL (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://mcrl:mcrl_dev_password@localhost:5432/mcrl

# Test Database Connection URL (Required for pytest - must differ from DATABASE_URL)
TEST_DATABASE_URL=postgresql+psycopg://mcrl:mcrl_dev_password@localhost:5432/mcrl_test

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Anonymous Session Expiration (days of inactivity)
SESSION_TTL_DAYS=30

# Environment mode ('development' or 'production')
ENVIRONMENT=development
